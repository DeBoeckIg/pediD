NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Keep the service-role key server-only; never expose it as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-me
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
PEDID_BUSINESS_CODE=replace-during-provisioning
PROVISIONING_SECRET=replace-with-a-deployment-only-secret
# Digits-only international WhatsApp number, without + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=5493813531217
NEXT_PUBLIC_BUSINESS_NAME=pediD
NEXT_PUBLIC_SHORT_LABEL=pediD
# Allowed values: indigo, emerald, blue, rose.
NEXT_PUBLIC_PRIMARY_COLOR=indigo
NEXT_PUBLIC_CURRENCY_LABEL=ARS
# Optional public path or URL, for example /logo.svg.
NEXT_PUBLIC_LOGO_PATH=
CSRF_ALLOWED_ORIGINS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_CRON_SECRET=
CRON_SECRET=
